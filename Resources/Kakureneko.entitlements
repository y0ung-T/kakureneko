<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Polite shutdown (opt-in, D2): Apple Event aevt/shut to loginwindow under the hardened runtime. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Not sandboxed: Kakureneko reads agent state, scans processes and edits agent configs (with consent). -->
</dict>
</plist>
