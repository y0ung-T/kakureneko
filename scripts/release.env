# Release configuration (docs/RELEASE.md). Sourced by scripts/build-app.sh, scripts/release-mac.sh and
# scripts/build-phone.sh. Empty values are not decided yet: the scripts say what is missing.

# Marketing version of the Mac and iPhone apps.
VERSION=1.0.0
# Build number. Empty: a UTC timestamp (YYYYMMDDHHMM), so every build is newer than the last.
BUILD_NUMBER=

# The website (download, privacy policy, support, the update feed). No trailing slash, https only.
# The app's links, Sparkle's feed and the iPhone app's privacy link all derive from it.
WEBSITE_URL=https://kakureneko.com
# The iPhone app's App Store page once it is live (https://apps.apple.com/app/id…). Empty: the website's /iphone/.
IPHONE_APP_URL=

# Copyright line in the Mac app (Finder's Get Info). TODO(release): your name or company.
COPYRIGHT=

# Sparkle's EdDSA public key (scripts/release-mac.sh keys prints it and writes it here).
SPARKLE_PUBLIC_KEY=

# notarytool keychain profile (scripts/release-mac.sh check explains how to create it).
NOTARY_PROFILE=kakureneko-notary
TEAM_ID=7NRW73MYQZ
