# Release configuration (docs/RELEASE.md). Sourced by scripts/build-app.sh, scripts/release-mac.sh and
# scripts/build-phone.sh. Empty values are not decided yet: the scripts say what is missing.

# Marketing version of the Mac and iPhone apps.
VERSION=1.0.0
# Build number. Empty: a UTC timestamp (YYYYMMDDHHMM), so every build is newer than the last.
BUILD_NUMBER=

# The project's GitHub repository (download, privacy policy, support). No trailing slash, https only.
# The apps' links derive from it: <this>/blob/main/PRIVACY.md, <this>/issues, <this>/#iphone; releases go to its
# GitHub Releases.
WEBSITE_URL=https://github.com/y0ung-T/kakureneko
# Sparkle's update feed: appcast.xml at the root of the repository, written by scripts/release-mac.sh publish.
APPCAST_URL=https://raw.githubusercontent.com/y0ung-T/kakureneko/main/appcast.xml
# The iPhone app's public TestFlight link (https://testflight.apple.com/join/…). Empty: the README's iPhone section.
IPHONE_APP_URL=

# Copyright line in the Mac app (Finder's Get Info). The developer's GitHub handle, by choice.
COPYRIGHT="© 2026 y0ung-T"

# Sparkle's EdDSA public key (scripts/release-mac.sh keys prints it and writes it here).
SPARKLE_PUBLIC_KEY=BUz6dC0Z/xuA4GaXIsdi0BOShJ1iFv0/YXLfdGhUEJA=

# notarytool keychain profile (scripts/release-mac.sh check explains how to create it).
NOTARY_PROFILE=kakureneko-notary
TEAM_ID=7NRW73MYQZ
